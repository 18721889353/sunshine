# ============================================================
# 阶段一：编译 Go 二进制文件
# ============================================================
FROM golang:1.25-alpine AS builder

WORKDIR /app

# 设置 Go 代理以加速依赖下载
RUN go env -w GOPROXY=https://goproxy.cn,https://mirrors.aliyun.com/goproxy,direct

# 先复制依赖文件，利用 Docker 分层缓存（依赖未变化时 go mod download 层可复用）
COPY go.mod go.sum ./
RUN go mod download

# 复制全部源码
COPY . .

# 编译二进制文件，-ldflags="-s -w" 去掉调试信息给二进制文件"瘦身"
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /serverNameExample cmd/serverNameExample/main.go

# ============================================================
# 阶段二：运行镜像
# ============================================================
FROM alpine:latest

LABEL maintainer="18721889353 <g.18721889353@gmail.com>"

# 设置上海时区
ENV TZ=Asia/Shanghai
RUN apk add --no-cache tzdata

# 创建非 root 用户，提升安全性
RUN adduser -D -u 1001 appuser

# todo generate dockerfile_build code for http or grpc here
# delete the templates code start

# 安装 curl，用于 http 服务健康检查；若部署在 k8s 可不安装
RUN apk add curl

# 从构建阶段复制产物
COPY --from=builder --chown=appuser:appuser /serverNameExample /app/serverNameExample
COPY --from=builder --chown=appuser:appuser /app/configs/serverNameExample.yml /app/configs/serverNameExample.yml
# delete the templates code end

# 切换到非 root 用户
USER appuser

WORKDIR /app

# 服务端口 6001 性能分析和指标端口 grpc 端口 7001 http 端口 8001
EXPOSE 7001 8001 6001

#CMD ["./serverNameExample", "-c", "configs/serverNameExample.yml"]
# 如使用配置中心，将 serverNameExample.yml 改为配置中心的配置文件。
CMD ["./serverNameExample", "-c", "configs/serverNameExample.yml", "-enable-cc"]


