# 腾讯云SMS配置示例
# 请复制此文件为 .env 并填写实际配置

# 腾讯云SMS配置
TENCENT_SECRET_ID=你的SecretID（从腾讯云控制台获取）
TENCENT_SECRET_KEY=你的SecretKey（从腾讯云控制台获取）
TENCENT_SMS_APP_ID=你的AppID（短信应用ID）

# 短信配置
SMS_SIGN_NAME=你的短信签名（需要在腾讯云审核通过）
SMS_TEMPLATE_ID=你的模板ID（需要在腾讯云审核通过）

# 测试手机号（请修改为实际要发送的手机号，格式：+8613711112222）
TEST_PHONE_NUMBER=+8613711112222
