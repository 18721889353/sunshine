# 邮件服务环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==================== 腾讯云SES配置 ====================
# 适用于 providerType: tencent_ses
TENCENT_AK=your_tencent_access_key_id
TENCENT_SK=your_tencent_secret_key

# ==================== 阿里云DM配置 ====================
# 适用于 providerType: aliyun_dm
ALIYUN_AK=your_aliyun_access_key_id
ALIYUN_SK=your_aliyun_secret_key

# ==================== SMTP配置 ====================
# 适用于 providerType: smtp
SMTP_USERNAME=your_email@qq.com
SMTP_PASSWORD=your_authorization_code

# ==================== 通用配置（可选）====================
# 如果不想使用特定平台的变量，可以使用通用变量
EMAIL_AK=your_access_key
EMAIL_SK=your_secret_key

# 使用说明：
# 1. 复制此文件：cp env.example .env
# 2. 填写实际的密钥值
# 3. 在代码中加载：source .env (Linux/Mac) 或 .\.env (Windows PowerShell)
# 4. 或者在项目启动时通过配置文件读取
