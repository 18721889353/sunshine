# pkg/goemail 集成测试环境变量示例
# 复制本文件为 .env 放在包目录（pkg/goemail/.env），`go test -tags=integration` 时
# TestMain 的 loadDotEnv 会自动读取：只补缺、不覆盖已设置的变量；# 开头为注释。
# 根 .gitignore 的 *.env 已覆盖该文件，不会入库。
# 变量集合与 integration_test.go 实际读取的 os.Getenv 常量表、README「集成测试」变量表一致。

# ==================== SMTP（TestIntegration_SendSMTP / SendBatchSMTP）====================
GOEMAIL_SMTP_HOST=smtp.example.com
# 可选，不设置默认 465
GOEMAIL_SMTP_PORT=465
GOEMAIL_SMTP_USERNAME=your_email@example.com
# SMTP 密码/授权码
GOEMAIL_SMTP_PASSWORD=your_password_or_auth_code
# 可选，"true"=强制隐式 SSL（465）；不设置或 "false" 按端口自适应（465 隐式 SSL，25/587 STARTTLS）
# GOEMAIL_SMTP_USE_TLS=true

# ==================== 腾讯云 SES（TestIntegration_SendTencent / SendTencentTemplate / QueryTencent）====================
GOEMAIL_TENCENT_SECRET_ID=your_tencent_secret_id
GOEMAIL_TENCENT_SECRET_KEY=your_tencent_secret_key
# 可选，不设置默认 ap-hongkong
# GOEMAIL_TENCENT_REGION=ap-hongkong
# 模板发送用（SendTencentTemplate 必填）
# GOEMAIL_TENCENT_TEMPLATE_ID=12345
# 可选，模板变量 JSON 对象，如 {"code":"123456"}
# GOEMAIL_TENCENT_TEMPLATE_DATA={"code":"123456"}

# ==================== 阿里云 DM（TestIntegration_SendAliyun / SendAliyunTemplate）====================
GOEMAIL_ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
GOEMAIL_ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
# 可选，不设置默认 cn-hangzhou
# GOEMAIL_ALIYUN_REGION=cn-hangzhou
# 预先在控制台创建并上传了收件人的收件人列表名称（SendAliyunTemplate 必填，非内联地址列表）
# GOEMAIL_ALIYUN_RECEIVERS_NAME=my_receivers
# 阿里云模板名称（SendAliyunTemplate 必填）
# GOEMAIL_ALIYUN_TEMPLATE_NAME=verification_code

# ==================== 测试地址（全部发送/查询用例必填）====================
# 发件人地址，须为服务商已验证的域名
GOEMAIL_TEST_FROM=sender@example.com
# 收件人地址
GOEMAIL_TEST_TO=receiver@example.com

# ==================== 运行开关（可选）====================
# 真实发送是付费操作，设为 1 才执行；不设置时发送类用例全部 Skip（查询不计费，不受此开关限制）
# GOEMAIL_ALLOW_PAID_SEND=1
# TestMain 总时长上限（Go duration），默认 120s
# GOEMAIL_TEST_TIMEOUT=120s
