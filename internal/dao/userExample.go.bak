	}
	if updates.Avatar != "" {
		update["avatar"] = updates.Avatar
	}
	if updates.Age > 0 {
		update["age"] = updates.Age
	}
	if updates.Gender > 0 {
		update["gender"] = updates.Gender
	}
	if updates.LoginAt > 0 {
