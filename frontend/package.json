{
  "name": "sunshine-web-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/post-build.js",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint:eslint": "eslint src/**/*.{vue,js,ts}",
    "lint:stylelint": "stylelint src/**/*.{vue,css}",
    "lint:prettier": "prettier --check src/**/*.{vue,js,ts,css}",
    "check": "pnpm run type-check && pnpm run lint:eslint && pnpm run lint:stylelint && pnpm run lint:prettier"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "axios": "^1.6.0",
    "element-plus": "^2.4.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.9.6",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.12"
  }
}
